{
  // 新しい監視のダッシュボード。合言葉・トークンは secret（NM_DASH_TOKEN・GH_DISPATCH_TOKEN）。値はリポジトリに置かない。
  // 画面は Cloudflare Access で守る（ACCESS_TEAM_DOMAIN・ACCESS_AUD を vars に入れるまで画面は 403）。
  "name": "nm-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "routes": [{ "pattern": "bukken.sevenart-projects.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "nm-dashboard", "database_id": "e80a8b60-8144-467f-b1b9-cc7dde3ba02d" }],
  // JST 8:05 / 12:05 / 15:05 / 18:05 に GitHub の巡回を起動する
  "triggers": { "crons": ["5 23,3,6,9 * * *"] },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
